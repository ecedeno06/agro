PORT=3000

# Database Configuration
DB_USER=postgres
DB_HOST=localhost
DB_DATABASE=agro_db
DB_PASSWORD=postgres
DB_PORT=5432

# Security Configuration
JWT_SECRET=super_secret_jwt_key_for_agro_project

# Superadmin Identity Verification (Ed25519)
SUPERUSER_PUBLIC_KEY_PATH=./secrets/superuser-public.pem
APP_ENVIRONMENT=development

# Google Geocoding API (reverse: coordenadas -> país/provincia/distrito).
# Restringir en Google Cloud Console a "Geocoding API" únicamente.
MAPKEY=

# Envío de correo transaccional (recuperar contraseña, reset por admin) vía
# Resend (https://resend.com), no SMTP. EMAIL_FROM debe usar un dominio
# verificado en la cuenta de Resend asociada al API key.
RESEND_API_KEY=
EMAIL_FROM=AgroNet <notificaciones@tudominio.com>

# URL pública del frontend (Vercel), usada para armar el enlace de acceso
# en el correo de invitación de usuarios.
FRONTEND_URL=https://agro-steel-nine.vercel.app
